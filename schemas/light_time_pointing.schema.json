{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Light-time-corrected asteroid radar pointing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "target",
    "observation",
    "transmit_station",
    "ephemeris",
    "solver"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "id_type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "id_type": {
          "type": ["string", "null"],
          "enum": ["smallbody", "designation", "name", "asteroid_name", null]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_utc", "time_role"],
      "properties": {
        "time_utc": {"type": "string", "minLength": 1},
        "time_role": {"enum": ["transmit", "receive"]}
      }
    },
    "transmit_station": {"$ref": "#/$defs/station"},
    "receive_station": {"$ref": "#/$defs/station"},
    "ephemeris": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earth", "cache"],
      "properties": {
        "earth": {"type": "string", "minLength": 1},
        "cache": {"type": "boolean"},
        "cache_directory": {"type": "string", "minLength": 1}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tolerance_s", "max_iterations"],
      "properties": {
        "tolerance_s": {"type": "number", "exclusiveMinimum": 0},
        "max_iterations": {"type": "integer", "minimum": 1}
      }
    },
    "output_json": {"type": "string"}
  },
  "$defs": {
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "longitude_deg", "latitude_deg", "height_m"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "height_m": {"type": "number"}
      }
    }
  }
}
