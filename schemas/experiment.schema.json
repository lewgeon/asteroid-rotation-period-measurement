{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/asteroid-rotation/experiment.schema.json",
  "title": "Asteroid rotation-period experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment",
    "target",
    "radar",
    "observation",
    "translation_doppler",
    "noise",
    "processing"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "seed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "semi_axes_m",
        "mesh_latitude_segments",
        "mesh_longitude_segments",
        "rotation_period_s",
        "initial_phase_deg",
        "spin_pole",
        "scattering"
      ],
      "properties": {
        "model_type": {"const": "ellipsoid_mesh"},
        "semi_axes_m": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "items": false
        },
        "mesh_latitude_segments": {"type": "integer", "minimum": 4},
        "mesh_longitude_segments": {"type": "integer", "minimum": 8},
        "rotation_period_s": {"type": "number", "exclusiveMinimum": 0},
        "initial_phase_deg": {"type": "number"},
        "spin_pole": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame", "lon_deg", "lat_deg"],
          "properties": {
            "frame": {"enum": ["icrs"]},
            "lon_deg": {"type": "number"},
            "lat_deg": {"type": "number", "minimum": -90, "maximum": 90}
          }
        },
        "scattering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cosine_power_tx",
            "cosine_power_rx",
            "spot_direction_body",
            "spot_angular_radius_deg",
            "spot_strength"
          ],
          "properties": {
            "cosine_power_tx": {"type": "number", "minimum": 0},
            "cosine_power_rx": {"type": "number", "minimum": 0},
            "spot_direction_body": {
              "type": "array",
              "prefixItems": [
                {"type": "number"},
                {"type": "number"},
                {"type": "number"}
              ],
              "items": false
            },
            "spot_angular_radius_deg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 180
            },
            "spot_strength": {"type": "number", "minimum": 1}
          }
        }
      }
    },
    "radar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "carrier_frequency_hz",
        "baseband_sample_rate_hz",
        "tx_line_of_sight_icrs",
        "rx_line_of_sight_icrs",
        "waveform"
      ],
      "properties": {
        "geometry": {"enum": ["monostatic", "bistatic"]},
        "carrier_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "baseband_sample_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "tx_line_of_sight_icrs": {"$ref": "#/$defs/vector3"},
        "rx_line_of_sight_icrs": {"$ref": "#/$defs/vector3"},
        "waveform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "continuous_wave"}
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_time_utc", "duration_s"],
      "properties": {
        "start_time_utc": {"type": "string", "minLength": 1},
        "duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "translation_doppler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polynomial_hz"],
      "properties": {
        "polynomial_hz": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"},
          "description": "Ascending coefficients: c0 + c1*t + c2*t^2 + ..."
        }
      }
    },
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snr_db"],
      "properties": {
        "snr_db": {"type": ["number", "null"]}
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stft_window_samples",
        "stft_overlap_fraction",
        "period_min_s",
        "period_max_s",
        "period_grid_size"
      ],
      "properties": {
        "stft_window_samples": {"type": "integer", "minimum": 16},
        "stft_overlap_fraction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "period_min_s": {"type": "number", "exclusiveMinimum": 0},
        "period_max_s": {"type": "number", "exclusiveMinimum": 0},
        "period_grid_size": {"type": "integer", "minimum": 100}
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    }
  }
}

